# PORT (fourni automatiquement par l'hébergeur en production)
PORT=3000
NODE_ENV=development

# Secrets : longues chaînes aléatoires, différentes l'une de l'autre
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=REMPLACER_PAR_VOTRE_SECRET_LONG_ET_COMPLEXE
OTP_SECRET=REMPLACER_PAR_UN_AUTRE_SECRET

# Base de données MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=gestion_stages
# true pour les bases hébergées (Aiven, TiDB Cloud…) qui exigent TLS
DB_SSL=false
DB_POOL_SIZE=10

# Derrière un proxy (Render, Koyeb…) : 1. Laisser vide en local.
TRUST_PROXY=

# Brevo SMTP
BREVO_USER=REMPLACER_PAR_VOTRE_EMAIL_BREVO
BREVO_PASS=REMPLACER_PAR_VOTRE_MOT_DE_PASSE_BREVO

# Email expéditeur
EMAIL_FROM=contact@votre-domaine.com
EMAIL_FROM_NAME=Plateforme Stages

# Adresse de la plateforme, pour le lien des e-mails (par défaut : première origine CORS)
APP_URL=

# Coordonnées du service des stages, affichées sur la page d'aide (vide = non affiché)
CONTACT_EMAIL=saber_guidara@medecinesfax.org
CONTACT_TELEPHONE=
CONTACT_ADRESSE=
CONTACT_HORAIRES=

# CORS
ALLOWED_ORIGINS=http://localhost:4200

# Uniquement pour npm run admin:create (ne pas laisser en production)
ADMIN_LOGIN=
ADMIN_PASSWORD=
