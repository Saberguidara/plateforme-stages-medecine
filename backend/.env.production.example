# Accès à la base de production (Render), pour les scripts lancés depuis ce poste :
#   FICHIER_ENV=.env.production npm run db:etat
# Copier ce fichier en .env.production (ignoré par Git) et recopier les valeurs depuis
# Render → service web → Environment. Ne jamais committer ni partager .env.production.
DB_HOST=
DB_PORT=
DB_USER=
DB_PASS=
DB_NAME=
DB_SSL=true
